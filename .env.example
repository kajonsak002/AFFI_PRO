# Server Configuration
PORT=3001
VITE_API_URL=http://localhost:3001

# TikTok Showcase API Configuration
# ใส่ Cookie จาก shop.tiktok.com เพื่อดึงสินค้า Showcase
TIKTOK_COOKIE=_fbp=...; sessionid=...; sid_tt=...; passport_csrf_token=...
TIKTOK_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# DeepSeek API Configuration
# ใช้ model deepseek-chat (รุ่นที่ราคาประหยัดที่สุด)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# System & Automation Options
# โหมด Dry Run (true = จำลองการทำงาน ไม่โพสต์จริง / false = โพสต์จริง)
DRY_RUN=true
MAX_RETRIES=3
POST_DELAY_SECONDS=60
